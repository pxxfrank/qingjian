{
  "name": "qingjian",
  "productName": "轻笺",
  "version": "1.2.1",
  "description": "轻笺 · 轻量 Windows 便笺：Markdown 所见即所得、贴边启动器、回收站、暗夜模式",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "vite build --config frontend/vite.config.mjs",
    "pretest": "npm run build",
    "test": "node tests/parse.test.js && node tests/store.test.js && node tests/reminders.test.js && node tests/launcher.test.js && electron tests/e2e-runner.js",
    "cert:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-dev-cert.ps1",
    "dist": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sign-and-package.ps1",
    "dist:unsigned": "npm run build && electron-builder --win"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "naive-ui": "^2.44.1",
    "vite": "^8.2.1",
    "vue": "^3.5.41"
  },
  "build": {
    "appId": "com.qingjian.note",
    "productName": "轻笺",
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "afterPack": "scripts/after-pack.js",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "store.js",
      "notes-parse.js",
      "note-index.js",
      "reminders.js",
      "reminder-scheduler.js",
      "launcher.js",
      "launcher-geometry.js",
      "preload.js",
      "frontend/dist/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "轻笺",
      "language": "2052",
      "installerLanguages": [
        "zh_CN"
      ],
      "artifactName": "Qingjian-Setup-${version}.exe"
    }
  }
}
